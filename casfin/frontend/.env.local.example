# ============================================
# OPTIONAL: Custom RPC (e.g. EC2 nginx proxy / your own node)
# Takes priority over Alchemy/Infura when set
# ============================================
# NEXT_PUBLIC_CASFIN_RPC_URL=https://your-ec2-host.example.com/rpc

# ============================================
# REQUIRED: Alchemy RPC URLs for Arbitrum Sepolia
# Get keys from: dashboard.alchemy.com
# Create app with: Chain=Arbitrum, Network=Arbitrum Sepolia
# MUST have NEXT_PUBLIC_ prefix to work in browser
# MUST also be added to Vercel → Settings → Environment Variables
# ============================================
NEXT_PUBLIC_ALCHEMY_ARB_SEPOLIA_RPC_1=https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY_1
NEXT_PUBLIC_ALCHEMY_ARB_SEPOLIA_RPC_2=https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY_2
NEXT_PUBLIC_ALCHEMY_ARB_SEPOLIA_RPC_3=https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY_3
NEXT_PUBLIC_ALCHEMY_ARB_SEPOLIA_RPC_4=https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY_4

# ============================================
# REQUIRED: Neon PostgreSQL Database
# Get credentials from: console.neon.tech
# Use the POOLED (pgbouncer) connection string
# ============================================
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
SYNC_API_KEY="change-me"

# ============================================
# OPTIONAL: Redis (Upstash) for live bet settlement
# Creates instant UI updates when keeper resolves bets
# Get credentials from: console.upstash.com → Create Redis → TCP tab
# ============================================
REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_ENDPOINT.upstash.io:6379
