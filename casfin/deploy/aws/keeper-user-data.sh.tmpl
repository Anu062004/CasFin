#!/bin/bash
set -euo pipefail

exec > >(tee -a /var/log/casfin-keeper-bootstrap.log | logger -t casfin-keeper-bootstrap -s 2>/dev/console) 2>&1

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y git curl ca-certificates

curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
apt-get install -y nodejs
npm install -g pm2

if [ ! -d /home/ubuntu/CasFin/.git ]; then
  runuser -l ubuntu -c 'git clone __REPO_URL__ /home/ubuntu/CasFin'
else
  runuser -l ubuntu -c 'git -C /home/ubuntu/CasFin pull --ff-only'
fi

printf '%s' '__ENV_BASE64__' | base64 -d > /home/ubuntu/CasFin/casfin/.env
chown ubuntu:ubuntu /home/ubuntu/CasFin/casfin/.env
chmod 600 /home/ubuntu/CasFin/casfin/.env

runuser -l ubuntu -c 'cd /home/ubuntu/CasFin/casfin && npm ci'
runuser -l ubuntu -c 'cd /home/ubuntu/CasFin/casfin && pm2 start npm --name casfin-keeper -- run keeper:start'
runuser -l ubuntu -c 'pm2 save'
runuser -l ubuntu -c 'pm2 status --no-color || true'
sleep 20
runuser -l ubuntu -c 'pm2 logs casfin-keeper --lines 50 --nostream || true'

env PATH=$PATH:/usr/bin pm2 startup systemd -u ubuntu --hp /home/ubuntu || true
